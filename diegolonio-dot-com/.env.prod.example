# Producción: copia este archivo a .env en el servidor y rellena los valores.
# Genera cada secreto con: python3 -c "import secrets; print(secrets.token_hex(32))"

# Password de Postgres (compose lo usa para el contenedor db y para armar
# el DATABASE_URL de la app; no hace falta escribirlo dos veces)
POSTGRES_PASSWORD=

# Firma de las cookies de sesión del admin
SECRET_KEY=

# Puerto del host donde escucha la app (el túnel apunta aquí). Opcional.
# APP_PORT=8000
